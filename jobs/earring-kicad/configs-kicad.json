[
 {
  "name": "core-full",
  "router": "ultraroute",
  "args": [
   "--negotiate",
   "--rip-up",
   "--tighten",
   "--timeout",
   "600"
  ]
 },
 {
  "name": "cr-gridneg005-nofan",
  "router": "copperroute",
  "args": [
   "--backend",
   "grid",
   "--set",
   "router.fanout.enabled=false",
   "--timeout",
   "600"
  ],
  "env": {
   "COPPERROUTE_GRID_NEGOTIATE": "1",
   "COPPERROUTE_GRID_CELL_MM": "0.05"
  }
 },
 {
  "name": "cr-maze",
  "router": "copperroute",
  "args": [
   "--timeout",
   "600"
  ]
 },
 {
  "name": "cr-tnudge-gridneg005-lock",
  "router": "copperroute",
  "args": [
   "--backend",
   "nudge",
   "--set",
   "router.fanout.enabled=false",
   "--timeout",
   "600"
  ],
  "env": {
   "COPPERROUTE_GRID_NEGOTIATE": "1",
   "COPPERROUTE_GRID_CELL_MM": "0.05",
   "COPPERROUTE_NUDGE_BASE": "grid"
  }
 }
]