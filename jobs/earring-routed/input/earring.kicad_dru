(version 1)

# JLCPCB 4-layer capability rules the single global knobs can't express.
# Global rules carry the VIA numbers (hole-to-copper 0.2, hole-to-hole 0.2);
# component through-holes are held to JLC's tighter PTH limits here.

(rule "JLC PTH hole to copper"
  (condition "A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))

(rule "JLC PTH hole to hole"
  (condition "A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
  (constraint hole_to_hole (min 0.45mm)))

# JLC lists SMD pad-to-pad (different nets) at 0.15, above the 0.127 global.
(rule "JLC SMD pad to pad"
  (condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))
